// Tasklane measures. Generated by build_pbip.py; paste into a _Measures table if rebuilding the model by hand.

Signups =
    COUNTROWS ( fact_user )

Verified Users =
    CALCULATE ( COUNTROWS ( fact_user ), fact_user[is_verified] = 1 )

Project Users =
    CALCULATE ( COUNTROWS ( fact_user ), fact_user[has_project] = 1 )

Activated Users =
    CALCULATE ( COUNTROWS ( fact_user ), fact_user[is_activated] = 1 )

Paid Users =
    CALCULATE ( COUNTROWS ( fact_user ), fact_user[is_paid] = 1 )

Activation Rate =
    DIVIDE ( [Activated Users], [Signups] )

Paid Conversion =
    DIVIDE ( [Paid Users], [Signups] )

Paid per Activated User =
    DIVIDE ( CALCULATE ( [Paid Users], fact_user[is_activated] = 1 ), [Activated Users] )

Funnel Users =
    SWITCH ( SELECTEDVALUE ( dim_funnel_stage[stage] ),
        "Signed up", [Signups], "Verified email", [Verified Users], "Created first project", [Project Users],
        "Activated", [Activated Users], "Paid", [Paid Users] )

W1 Retention =
    AVERAGE ( fact_user[w1_active] )

W4 Retention =
    AVERAGE ( fact_user[w4_active] )

W8 Retention =
    AVERAGE ( fact_user[w8_active] )

Cohort Retention =
    DIVIDE ( SUM ( cohort_retention_weekly[active_users] ), SUM ( cohort_retention_weekly[cohort_size] ) )

New MRR per Signup =
    DIVIDE ( SUM ( fact_user[mrr_usd] ), [Signups] )

Avg MRR per Customer =
    DIVIDE ( SUM ( fact_user[mrr_usd] ), [Paid Users] )

Customers Churned =
    CALCULATE ( COUNTROWS ( fact_user ), fact_user[is_churned] = 1 )

Customer Months =
    SUM ( fact_user[customer_months] )

Monthly Churn Rate =
    DIVIDE ( [Customers Churned], [Customer Months] )

New MRR =
    SUM ( mrr_monthly[new_mrr] )

Churned MRR =
    SUM ( mrr_monthly[churned_mrr] )

Net New MRR =
    [New MRR] - [Churned MRR]

MRR Churn Rate =
    DIVIDE ( [Churned MRR], SUM ( mrr_monthly[mrr_start] ) )

Exp Users =
    CALCULATE ( COUNTROWS ( fact_user ), fact_user[in_experiment] = 1 )

Exp Activated =
    CALCULATE ( COUNTROWS ( fact_user ), fact_user[in_experiment] = 1, fact_user[is_activated] = 1 )

Exp Activation Rate =
    DIVIDE ( [Exp Activated], [Exp Users] )

Exp Paid 30d Rate =
    DIVIDE ( CALCULATE ( COUNTROWS ( fact_user ), fact_user[in_experiment] = 1, fact_user[is_paid_30d] = 1 ), [Exp Users] )

Control Activation Rate =
    CALCULATE ( [Exp Activation Rate], fact_user[experiment_variant] = "control" )

Treatment Activation Rate =
    CALCULATE ( [Exp Activation Rate], fact_user[experiment_variant] = "treatment" )

Activation Lift =
    [Treatment Activation Rate] - [Control Activation Rate]

Relative Lift =
    DIVIDE ( [Activation Lift], [Control Activation Rate] )

Lift Std Error =
    VAR pc = [Control Activation Rate]
    VAR pt = [Treatment Activation Rate]
    VAR nc = CALCULATE ( [Exp Users], fact_user[experiment_variant] = "control" )
    VAR nt = CALCULATE ( [Exp Users], fact_user[experiment_variant] = "treatment" )
    RETURN SQRT ( DIVIDE ( pc * ( 1 - pc ), nc ) + DIVIDE ( pt * ( 1 - pt ), nt ) )

Lift CI Low =
    [Activation Lift] - 1.96 * [Lift Std Error]

Lift CI High =
    [Activation Lift] + 1.96 * [Lift Std Error]

Lift z-score =
    DIVIDE ( [Activation Lift], [Lift Std Error] )

Lift p-value =
    2 * ( 1 - NORM.S.DIST ( ABS ( [Lift z-score] ), TRUE ) )

Lift p-value Text =
    IF ( [Lift p-value] < 0.0001, "< 0.0001", FORMAT ( [Lift p-value], "0.0000" ) )

Lift Summary =
    FORMAT ( [Activation Lift] * 100, "+0.00;-0.00" ) & " pts (95% CI " & FORMAT ( [Lift CI Low] * 100, "+0.00;-0.00" )
        & " to " & FORMAT ( [Lift CI High] * 100, "+0.00;-0.00" ) & ")"
