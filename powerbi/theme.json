{
  "name": "Tasklane - Monochrome",
  "dataColors": ["#1D4E89", "#5B84B1", "#9DB7D5", "#C9D6E6", "#6B7280", "#9CA3AF", "#D1D5DB", "#1F2937"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1D4E89",
  "maximum": "#1D4E89",
  "center": "#C9D6E6",
  "minimum": "#F3F6FA",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2937" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#6B7280" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1D4E89" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "gridlineStyle": [{ "gridlineColor": { "solid": { "color": "#E5E7EB" } }, "gridlineThickness": 0.6 }],
        "border": [{ "show": false }],
        "background": [{ "show": false }]
      }
    }
  }
}
